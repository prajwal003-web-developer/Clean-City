# Backend API base URL (include /api). On other devices use the backend machine's LAN IP, not localhost.
VITE_API_URL=http://localhost:5000/api

# "cookie" -> httpOnly cookie session (withCredentials). "bearer" -> JWT in Authorization header.
VITE_AUTH_MODE=cookie

# Nearby route contract (verify against backend getNearbyReports controller)
VITE_NEARBY_LAT_PARAM=lat
VITE_NEARBY_LNG_PARAM=lng
VITE_NEARBY_DISTANCE_PARAM=distance
# "meters" sends 10000 for 10 km, "km" sends 10
VITE_NEARBY_DISTANCE_UNIT=meters
